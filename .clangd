CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -Wno-unused-function

---
If:
  PathMatch: test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch:
    - src/.*
    - zsh_extended_glob/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch:
    - common/.*\.h
    - test/[^/]*\.c
CompileFlags:
  Add:
    - -I../src

---
If:
  PathMatch: common/scanner\.h
CompileFlags:
  Add:
    - -DZSH_EXTENDED_GLOB=0

---
If:
  PathMatch:
    - src/scanner\.c
    - zsh_extended_glob/src/scanner\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch: bindings/python/.*\.c
CompileFlags:
  Add:
    - -I../../src
