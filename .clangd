CompileFlags:
  Add:
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.(c|h)
CompileFlags:
  Add:
    - -std=c17
    - -xc

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header

---
If:
  PathMatch:
    - .*\.h
    - test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch:
    - src/.*
    - zsh_extended_glob/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch:
    - common/.*\.h
    - test/[^/]*\.c
CompileFlags:
  Add:
    - -I../src

---
If:
  PathMatch: common/scanner\.h
CompileFlags:
  Add:
    - -DZSH_EXTENDED_GLOB=0

---
If:
  PathMatch:
    - src/scanner\.c
    - zsh_extended_glob/src/scanner\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch: bindings/node/.*\.cc
CompileFlags:
  CompilationDatabase: build/Release
  Add:
    - -std=c++17

---
If:
  PathMatch: bindings/python/.*\.c
CompileFlags:
  CompilationDatabase: None
  Add:
    - -I../../src
