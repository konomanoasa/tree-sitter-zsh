{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "zsh",
      "title": "zsh",
      "scope": "source.zsh",
      "path": ".",
      "file-types": ["zsh"],
      "injection-regex": "^zsh$",
      "highlights": "queries/highlights.scm",
      "external-files": [
        "common/scanner.h",
        "common/source.h",
        "common/input.h",
        "src/tokens.h",
        "common/tokens.json"
      ]
    },
    {
      "name": "zsh_extended_glob",
      "title": "zsh (extended glob)",
      "scope": "source.zsh_extended_glob",
      "path": "zsh_extended_glob",
      "file-types": ["zsh_extended_glob"],
      "injection-regex": "^zsh_extended_glob$",
      "highlights": "queries/highlights.scm",
      "external-files": [
        "common/scanner.h",
        "common/source.h",
        "common/input.h",
        "common/tokens.json",
        "zsh_extended_glob/src/tokens.h",
        "src/parser.c",
        "src/tree_sitter/parser.h"
      ]
    }
  ],
  "metadata": {
    "version": "0.4.1",
    "license": "MIT",
    "description": "Tree-sitter grammars for zsh.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-zsh"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
