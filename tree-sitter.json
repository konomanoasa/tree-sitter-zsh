{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "zsh",
      "title": "Zsh",
      "scope": "source.zsh",
      "path": ".",
      "file-types": ["zsh"],
      "injection-regex": "^zsh$",
      "highlights": "queries/highlights.scm",
      "external-files": [
        "src/source.h",
        "src/input.h",
        "src/tokens.h",
        "src/tokens.json"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Zsh.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-zsh"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
